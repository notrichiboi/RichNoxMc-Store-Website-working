rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator'
        );
    }

    // Public read-only collections (managed by admins)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /voteLinks/{voteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /voteRewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ruleCategories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /patrons/{patronId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /patronTiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /currencies/{currencyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /navigation/{navId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin users collection
    match /users/{userId} {
      // Allow authenticated user to read their own profile to verify admin privileges
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only existing admins can assign/edit roles
      allow write: if isAdmin();
    }

    // Explicitly block any other access (No orders or transaction tables)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
